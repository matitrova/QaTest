{
  "info": {
    "name": "Restful Booker — QaTest",
    "description": "Recorrido completo sobre Restful Booker: autenticación por token, alta, consulta, modificación y borrado de reservas, más los casos negativos. Es la misma suite que RestfulBookerTest/ en Python, hecha en Postman para comparar las dos herramientas. Funciona recién importada, sin elegir ningún environment: base_url y las credenciales de demo tienen un valor por defecto en la colección. Si se elige el environment \"Restful Booker\", sus valores tienen prioridad.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://restful-booker.herokuapp.com"
    },
    {
      "key": "usuario",
      "value": "admin"
    },
    {
      "key": "clave",
      "value": "password123"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "booking_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Obtener token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const datos = pm.response.json();",
                  "pm.test(\"Devuelve un token\", () => {",
                  "    pm.expect(datos).to.have.property(\"token\");",
                  "    pm.expect(datos.token).to.be.a(\"string\").and.not.be.empty;",
                  "});",
                  "",
                  "// El token queda guardado para los pedidos que lo necesitan (modificar y borrar).",
                  "pm.collectionVariables.set(\"token\", datos.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{usuario}}\",\n  \"password\": \"{{clave}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Clave incorrecta: 200 pero sin token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Restful Booker responde 200 aunque el login falle: el error viene en el cuerpo.",
                  "// Un test que solo mirara el status code daría este login por bueno. Por eso lo",
                  "// que se valida es que NO haya token y que el cuerpo explique el error.",
                  "pm.test(\"Responde 200 aunque la clave sea incorrecta\", () => pm.response.to.have.status(200));",
                  "",
                  "const datos = pm.response.json();",
                  "pm.test(\"No devuelve token\", () => pm.expect(datos).to.not.have.property(\"token\"));",
                  "pm.test(\"Explica el error en el cuerpo\", () => pm.expect(datos.reason).to.eql(\"Bad credentials\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth"
              ]
            },
            "description": "Caso negativo. Demuestra que un status 200 no alcanza para dar un login por bueno.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{usuario}}\",\n  \"password\": \"clave-incorrecta\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Reservas",
      "item": [
        {
          "name": "Listar reservas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const datos = pm.response.json();",
                  "pm.test(\"Devuelve una lista\", () => pm.expect(datos).to.be.an(\"array\"));",
                  "pm.test(\"Cada reserva tiene un bookingid numérico\", () => {",
                  "    datos.forEach(r => pm.expect(r.bookingid).to.be.a(\"number\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/booking",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "booking"
              ]
            }
          }
        },
        {
          "name": "Crear reserva",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const datos = pm.response.json();",
                  "pm.test(\"Devuelve el id de la reserva\", () => pm.expect(datos.bookingid).to.be.a(\"number\"));",
                  "",
                  "pm.test(\"Guarda exactamente lo que se envió\", () => {",
                  "    const enviado = JSON.parse(pm.request.body.raw);",
                  "    pm.expect(datos.booking.firstname).to.eql(enviado.firstname);",
                  "    pm.expect(datos.booking.totalprice).to.eql(enviado.totalprice);",
                  "    pm.expect(datos.booking.bookingdates).to.eql(enviado.bookingdates);",
                  "});",
                  "",
                  "pm.collectionVariables.set(\"booking_id\", datos.bookingid);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/booking",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "booking"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"Matias\",\n  \"lastname\": \"Trovato\",\n  \"totalprice\": 150,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2026-10-01\",\n    \"checkout\": \"2026-10-05\"\n  },\n  \"additionalneeds\": \"Desayuno\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Consultar la reserva creada",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A diferencia de ReqRes, Restful Booker sí guarda los cambios: lo que se creó se",
                  "// puede volver a pedir. Por eso acá sí tiene sentido verificar consultando de nuevo.",
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const datos = pm.response.json();",
                  "pm.test(\"Devuelve la reserva que se creó\", () => {",
                  "    pm.expect(datos.firstname).to.eql(\"Matias\");",
                  "    pm.expect(datos.lastname).to.eql(\"Trovato\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/booking/{{booking_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "booking",
                "{{booking_id}}"
              ]
            }
          }
        },
        {
          "name": "Modificar reserva (PUT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const datos = pm.response.json();",
                  "pm.test(\"Aplica todos los cambios\", () => {",
                  "    pm.expect(datos.firstname).to.eql(\"Matías\");",
                  "    pm.expect(datos.totalprice).to.eql(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "token={{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/booking/{{booking_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "booking",
                "{{booking_id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"Matías\",\n  \"lastname\": \"Trovato\",\n  \"totalprice\": 200,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2026-10-01\",\n    \"checkout\": \"2026-10-05\"\n  },\n  \"additionalneeds\": \"Desayuno\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Modificar un solo campo (PATCH)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const datos = pm.response.json();",
                  "pm.test(\"Cambia el campo enviado\", () => pm.expect(datos.additionalneeds).to.eql(\"Cena\"));",
                  "pm.test(\"No toca el resto de la reserva\", () => {",
                  "    pm.expect(datos.firstname).to.eql(\"Matías\");",
                  "    pm.expect(datos.totalprice).to.eql(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "token={{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/booking/{{booking_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "booking",
                "{{booking_id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"additionalneeds\": \"Cena\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Borrar sin token: 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Sin token, rechaza el borrado con 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/booking/{{booking_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "booking",
                "{{booking_id}}"
              ]
            },
            "description": "Caso negativo: la operación exige autenticación."
          }
        },
        {
          "name": "Borrar con token: 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Restful Booker responde 201 \"Created\" a un borrado exitoso. No es lo que indica la",
                  "// convención (200 o 204), pero es lo que hace esta API, y el test valida su",
                  "// comportamiento real. Si algún día pasara a 204, este test avisaría del cambio.",
                  "pm.test(\"Borra la reserva y responde 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "token={{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/booking/{{booking_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "booking",
                "{{booking_id}}"
              ]
            }
          }
        },
        {
          "name": "Verificar que se borró",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"La reserva ya no existe\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/booking/{{booking_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "booking",
                "{{booking_id}}"
              ]
            }
          }
        },
        {
          "name": "Reserva inexistente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Una reserva inexistente responde 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/booking/999999999",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "booking",
                "999999999"
              ]
            },
            "description": "Caso negativo."
          }
        }
      ]
    }
  ]
}